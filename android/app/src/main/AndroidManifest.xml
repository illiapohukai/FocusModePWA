<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Re-plans reminders and recovers a Session after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Deliberately NOT requested: SCHEDULE_EXACT_ALARM, USE_EXACT_ALARM, SYSTEM_ALERT_WINDOW,
         QUERY_ALL_PACKAGES, BIND_ACCESSIBILITY_SERVICE, BIND_DEVICE_ADMIN, notification listener,
         SMS, contacts, call log, location, microphone, camera. -->

    <!-- v21: Credential Manager's passkey support would add biometric permissions. Passkeys are
         not a v21 flow (Sign in with Google only), so they are removed. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <!-- v22: added by the reCAPTCHA SDK that firebase-auth depends on. reCAPTCHA serves phone and
         email/password sign-in, which this app does not use (Sign in with Google only, and its
         RecaptchaActivity is removed below), so the Gservices read permission is not requested. -->
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" tools:node="remove" />

    <application
        android:name=".FocusModeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusMode"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v22: no VIEW intent filter. The app's own notifications open this activity with
                 explicit, immutable PendingIntents whose focusmode:// route carries a per-install
                 tag; routes from any other caller are ignored (DeepLinkAuthenticator). Without the
                 filter no other app (and no second Focus Mode+ build) can claim or resolve the
                 scheme implicitly. -->
        </activity>

        <receiver
            android:name=".SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- v21: Firebase Auth's browser-redirect (GenericIdp) and reCAPTCHA activities serve web
             OAuth providers and phone sign-in. Sign in with Google uses Credential Manager and
             signInWithCredential, so these exported activities are not needed and are removed. -->
        <activity
            android:name="com.google.firebase.auth.internal.GenericIdpActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <activity
            android:name="com.google.firebase.auth.internal.RecaptchaActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- WorkManager is initialized on demand with the Hilt worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
